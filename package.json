{
  "name": "verdia",
  "version": "0.1.0",
  "private": true,
  "description": "An AI agent that grounds a ClinicalTrials.gov trial in the full PrimeKG knowledge graph and finds its connections as live neural signals in 3D",
  "type": "module",
  "scripts": {
    "primekg": "node --max-old-space-size=6144 scripts/build-primekg.mjs",
    "dev": "concurrently -k -n api,web -c cyan,magenta \"node --watch server/index.js\" \"vite\"",
    "build": "vite build",
    "start": "vite build && NODE_ENV=production node server/index.js"
  },
  "dependencies": {
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "vite": "^8.3.4"
  }
}
