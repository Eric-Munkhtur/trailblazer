# Set ONE of these. The provider is auto-detected from whichever key is present.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional overrides
# LLM_PROVIDER=openai        # openai | anthropic | mock (mock = offline demo, no real LLM)
# LLM_MODEL=gpt-5-mini       # default: gpt-5-mini (openai) / claude-sonnet-4-5 (anthropic)
# OPENAI_BASE_URL=https://api.openai.com/v1   # any OpenAI-compatible endpoint (e.g. OpenRouter)
# PORT=8790
